      <Ordine>20</Ordine>
      <Capitolo>Verfahren zum Einfüllen und Prüfen des Ölstands im Automatikgetriebe</Capitolo>
      <Corpo> &lt;html xmlns:v=&quot;urn:schemas-microsoft-com:vml&quot; xmlns:o=&quot;urn:schemas-microsoft-com:office:office&quot; xmlns:w=&quot;urn:schemas-microsoft-com:office:word&quot; xmlns:m=&quot;http://schemas.microsoft.com/office/2004/12/omml&quot; xmlns=&quot;http://www.w3.org/TR/REC-html40&quot;&gt;     &lt;body lang=IT style=&apos;tab-interval:35.4pt&apos;&gt;  &lt;div class=WordSection1&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;font-size:12.0pt;line-height:107%;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Stellen Sie das Fahrzeug auf eine ebene Fläche und blockieren Sie die Räder.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Ausschalten von Beleuchtung und Klimaanlagen&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Stellen Sie den Schalthebel auf &lt;B&gt;P&lt;/B&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Betätigen Sie die Feststellbremse&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:12.0pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Einfülldeckel &lt;B&gt;B &lt;/B&gt;entfernen&lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;VORSICHT: &lt;/B&gt;Tauschen Sie immer den Einfülldeckel &lt;B&gt;B &lt;/B&gt;und seine Dichtung aus.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:0cm;margin-bottom:.0001pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; &lt;B&gt;9,28 Liter &lt;/B&gt;Getriebeöl durch die Einfüllöffnung &lt;B&gt;B &lt;/B&gt;nachfüllen, bis ein leichtes Tropfen aus der Einfüllöffnung &lt;B&gt;B &lt;/B&gt;zu hören ist.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Starten Sie den Motor&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:12.0pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Getriebeöl durch Einfüllöffnung &lt;B&gt;B &lt;/B&gt;einfüllen, bis es leicht tropft&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:0cm;margin-bottom:.0001pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Wenn das Fahrzeug mit einem Getriebeölkühler ausgestattet ist&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;ul type=disc&gt; &lt;li class=MsoNormal style=&apos;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto; line-height:normal;mso-list:l1 level1 lfo1;tab-stops:list 36.0pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Füllen Sie weitere &lt;B&gt;0,5 Liter &lt;/B&gt;Getriebeöl ein.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/li&gt; &lt;li class=MsoNormal style=&apos;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto; line-height:normal;mso-list:l1 level1 lfo1;tab-stops:list 36.0pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Setzen Sie einen neuen Einfülldeckel &lt;B&gt;B &lt;/B&gt;mit seiner Dichtung ein und ziehen Sie ihn mit &lt;B&gt;35 Nm &lt;/B&gt;an.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/li&gt; &lt;li class=MsoNormal style=&apos;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto; line-height:normal;mso-list:l1 level1 lfo1;tab-stops:list 36.0pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Fahren Sie das Fahrzeug, bis sich das Thermostatventil öffnet.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/li&gt; &lt;/ul&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:0cm;margin-bottom:.0001pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Wenn das Fahrzeug nicht mit einem Getriebeölkühler ausgestattet ist&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;ul type=disc&gt; &lt;li class=MsoNormal style=&apos;mso-margin-top-alt:auto;mso-margin-bottom-alt:auto; line-height:normal;mso-list:l0 level1 lfo2;tab-stops:list 36.0pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Setzen Sie einen neuen Einfülldeckel &lt;B&gt;B &lt;/B&gt;mit seiner Dichtung ein und ziehen Sie ihn mit &lt;B&gt;35 Nm &lt;/B&gt;an.&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/li&gt; &lt;/ul&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:0cm;margin-bottom:.0001pt&apos;&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&amp;#61623; Mit der Ölstandskontrolle des Automatikgetriebes fortfahren&lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;WARNUNG: &lt;/B&gt;Die Ölstandskontrolle des Automatikgetriebes muss mit dem Diagnosegerät durchgeführt werden&lt;/span&gt;&lt;/p&gt;  &lt;/div&gt;  &lt;/body&gt;  &lt;/html&gt;</Corpo>
