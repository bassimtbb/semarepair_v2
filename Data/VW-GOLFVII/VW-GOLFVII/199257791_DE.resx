o-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Liter&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;5,5 ~ 6,0&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;tr style=&apos;mso-yfti-irow:6&apos;&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Automatikgetriebeöl - Menge für die Getriebespühlung:&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Liter&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;9,2&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;tr style=&apos;mso-yfti-irow:7;mso-yfti-lastrow:yes&apos;&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Temperaturkontrolle Ölstand Automatikgetriebe:&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;C°&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;35 ~ 45°&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;/TABLE&gt; 