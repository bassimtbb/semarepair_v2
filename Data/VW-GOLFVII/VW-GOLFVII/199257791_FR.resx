font-family:&quot;Times New Roman&quot;&apos;&gt;35 ~ 45°&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;/TABLE&gt;  &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;&lt;BR/&gt; &lt;span style=&apos;mso-spacerun:yes&apos;&gt; &lt;/span&gt;Effectuer le contrôle du niveau d&apos;huile de la transmission automatique avec le moteur en marche.&lt;/span&gt;&lt;/p&gt;  &lt;/div&gt;  &lt;/body&gt;  &lt;/html&gt;</Corpo>
