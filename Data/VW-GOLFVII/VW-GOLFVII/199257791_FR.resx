&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;tr style=&apos;mso-yfti-irow:3&apos;&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Huile de transmission automatique - Spécification du fabricant :&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;N.Ref&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;VW G 055 529 A2&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;tr style=&apos;mso-yfti-irow:4&apos;&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Huile de transmission automatique - Quantité à vide :&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Litres&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;7,2&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;tr style=&apos;mso-yfti-irow:5&apos;&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Huile de transmission automatique - Quantité à remplacer :&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD st