      <Corpo> &lt;html xmlns:v=&quot;urn:schemas-microsoft-com:vml&quot; xmlns:o=&quot;urn:schemas-microsoft-com:office:office&quot; xmlns:w=&quot;urn:schemas-microsoft-com:office:word&quot; xmlns:m=&quot;http://schemas.microsoft.com/office/2004/12/omml&quot; xmlns=&quot;http://www.w3.org/TR/REC-html40&quot;&gt;     &lt;body lang=IT style=&apos;tab-interval:35.4pt&apos;&gt;  &lt;div class=WordSection1&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:12.0pt&apos;&gt;&lt;B&gt;&lt;span style=&apos;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;Fabricant : &lt;/span&gt;&lt;/B&gt;&lt;span style=&apos;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;Volkswagen AG&lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;Désignation : &lt;/B&gt;0GC / DQ381-7&lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;Nom commercial : &lt;/B&gt;DSG7, S-Tronic &lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;Intervalle de vidange d&apos;huile recommandé par le fabricant de la boîte de vitesses automatique : &lt;/B&gt;&lt;BR/&gt; 60 000 km&lt;/span&gt;&lt;span style=&apos;font-size:12.0pt;line-height:107%;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;TABLE class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 width=&quot;99%&quot; style=&apos;width:99.0%;mso-cellspacing:0cm;mso-yfti-tbllook:1184&apos;&gt; &lt;tr style=&apos;mso-yfti-irow:0;mso-yfti-firstrow:yes&apos;&gt; &lt;TD width=&quot;60%&quot; style=&apos;width:60.0%;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal align=center style=&apos;margin-bottom:0cm;margin-bottom:.0001pt; text-align:center&apos;&gt;&lt;B&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Description&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/B&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD width=&quot;25%&quot; style=&apos;width:25.0%;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal align=center style=&apos;text-align:center&apos;&gt;&lt;B&gt;&lt;span style=&apos;ms