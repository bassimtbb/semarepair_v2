      <Corpo> &lt;html xmlns:v=&quot;urn:schemas-microsoft-com:vml&quot; xmlns:o=&quot;urn:schemas-microsoft-com:office:office&quot; xmlns:w=&quot;urn:schemas-microsoft-com:office:word&quot; xmlns:m=&quot;http://schemas.microsoft.com/office/2004/12/omml&quot; xmlns=&quot;http://www.w3.org/TR/REC-html40&quot;&gt;     &lt;body lang=IT style=&apos;tab-interval:35.4pt&apos;&gt;  &lt;div class=WordSection1&gt;  &lt;p class=MsoNormal style=&apos;margin-bottom:12.0pt&apos;&gt;&lt;B&gt;&lt;span style=&apos;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;Fabricante: &lt;/span&gt;&lt;/B&gt;&lt;span style=&apos;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;Volkswagen AG&lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;Denominación: &lt;/B&gt;0GC / DQ381-7&lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;Nombre comercial: &lt;/B&gt;DSG7, S-Tronic &lt;BR/&gt; &lt;BR/&gt; &lt;B&gt;Intervalo de cambio de aceite recomendado por el fabricante de la transmisión automática: &lt;/B&gt;&lt;BR/&gt; 60.000 km&lt;/span&gt;&lt;span style=&apos;font-size:12.0pt;line-height:107%;mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt;  &lt;TABLE class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 width=&quot;99%&quot; style=&apos;width:99.0%;mso-cellspacing:0cm;mso-yfti-tbllook:1184&apos;&gt; &lt;tr style=&apos;mso-yfti-irow:0;mso-yfti-firstrow:yes&apos;&gt; &lt;TD width=&quot;60%&quot; style=&apos;width:60.0%;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal align=center style=&apos;margin-bottom:0cm;margin-bottom:.0001pt; text-align:center&apos;&gt;&lt;B&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Descripción&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/B&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD width=&quot;25%&quot; style=&apos;width:25.0%;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal align=center style=&apos;text-align:center&apos;&gt;&lt;B&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Unidades de medida&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/B&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD width=&quot;15%&quot; style=&apos;width:15.0%;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal align=center style=&apos;text-align:center&apos;&gt;&lt;B&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Datos&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/B&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;tr style=&apos;mso-yfti-irow:1&apos;&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Código de transmisión automática:&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;N.Ref&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;0GC&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;/TR&gt; &lt;tr style=&apos;mso-yfti-irow:2&apos;&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;Informes numéricos:&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;N°&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt;/TD&gt; &lt;TD style=&apos;padding:.75pt .75pt .75pt .75pt&apos;&gt; &lt;p class=MsoNormal&gt;&lt;span style=&apos;mso-fareast-font-family:&quot;Times New Roman&quot;&apos;&gt;7&lt;o:p&gt;&lt;/o:p&gt;&lt;/span&gt;&lt;/p&gt; &lt